{
	"name": "yae-bot",
	"description": "🚀 A lightweight, high-performance Yae Discord Companion powered by Bun & Seyfert",
	"author": "OuOSama",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@slipher/watcher": "^0.0.9",
		"@types/bun": "^1.3.14",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@google/genai": "^2.17.1",
		"hoshimi": "^0.5.4",
		"seyfert": "5"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun --bun run ./watch.config.ts",
		"start": "NODE_ENV=production bun --bun run ./src/app.js",
		"check": "bunx biome check --write",
		"prepare": "bunx husky",
		"remove-commands": "bun run ./src/script/remove_commandst.ts"
	},
	"lint-staged": {
		"*.{ts,json,d.ts}": [
			"bunx biome check --write --no-errors-on-unmatched"
		]
	},
	"license": "MIT"
}
